{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "keepTime": true,
      "title": "12 Auth Sessions",
      "type": "link",
      "url": "/d/auth-sessions"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "keepTime": true,
      "title": "08 WildFly Audit",
      "type": "link",
      "url": "/d/wildfly-security"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Privileged operation attempts per second (all outcomes).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_authz_attempts_total{job=\"kitchensink-app\"}[5m]))",
          "legendFormat": "authz/s",
          "refId": "A"
        }
      ],
      "title": "Authz / sec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of privileged attempts that were allowed (when attempts > 0).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.35 },
              { "color": "green", "value": 0.55 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_authz_attempts_total{job=\"kitchensink-app\",outcome=\"allowed\"}[5m])) / sum(rate(kitchensink_authz_attempts_total{job=\"kitchensink-app\"}[5m]))",
          "legendFormat": "allowed",
          "refId": "A"
        }
      ],
      "title": "Allow Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Denied privileged attempts / sec (wrong role).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 0.02 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_authz_attempts_total{job=\"kitchensink-app\",outcome=\"denied\"}[5m]))",
          "legendFormat": "denied",
          "refId": "A"
        }
      ],
      "title": "Denied / sec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Privileged calls with no app session.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_authz_attempts_total{job=\"kitchensink-app\",outcome=\"unauthenticated\"}[5m]))",
          "legendFormat": "unauth",
          "refId": "A"
        }
      ],
      "title": "Unauthenticated / sec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Accounts with role=admin.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "kitchensink_accounts_by_role{job=\"kitchensink-app\",role=\"admin\"}",
          "legendFormat": "admins",
          "refId": "A"
        }
      ],
      "title": "Admins",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "p95 privileged op latency (all operations).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kitchensink_authz_duration_seconds_bucket{job=\"kitchensink-app\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "Authz p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Are privileged actions correctly allowed or denied?",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(kitchensink_authz_attempts_total{job=\"kitchensink-app\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Authz Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Allowed vs denied split by privileged operation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum by (operation, outcome) (rate(kitchensink_authz_attempts_total{job=\"kitchensink-app\",outcome=~\"allowed|denied\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Allow / Deny by Operation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Outcome totals since process start.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "id": 9,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum by (outcome) (kitchensink_authz_attempts_total{job=\"kitchensink-app\"})",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Outcomes (total)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Role distribution (panel inside 15 вЂ” not a separate board).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "id": 10,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "kitchensink_accounts_by_role{job=\"kitchensink-app\"}",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ],
      "title": "Accounts by Role",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latency by privileged operation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum by (operation) (rate(kitchensink_authz_duration_seconds_sum{job=\"kitchensink-app\"}[5m])) / clamp_min(sum by (operation) (rate(kitchensink_authz_duration_seconds_count{job=\"kitchensink-app\"}[5m])), 1e-9)",
          "legendFormat": "{{operation}} avg",
          "refId": "A"
        }
      ],
      "title": "Authz Duration by Op",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["grp-security", "kitchensink", "authorization", "auth", "business"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "15 Authorization & Privileged Ops",
  "uid": "app-authorization",
  "version": 2,
  "weekStart": ""
}
