      "pluginVersion": "11.6.1",
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "{job=\"wildfly\", level=~\"$level\"}", "queryType": "range", "refId": "A" }
      ],
      "title": "Live Logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
