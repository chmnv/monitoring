    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Log volume over time, broken down by level. Bars stack so total height = total lines; a red/yellow spike flags a burst of errors/warnings.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "",
            "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "bars", "fillOpacity": 80,
            "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5,
            "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }, "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [ { "id": "color", "value": { "fixedColor": "semi-dark-red", "mode": "fixed" } } ] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [ { "id": "color", "value": { "fixedColor": "semi-dark-yellow", "mode": "fixed" } } ] },
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [ { "id": "color", "value": { "fixedColor": "semi-dark-green", "mode": "fixed" } } ] },
          { "matcher": { "id": "byName", "options": "DEBUG" }, "properties": [ { "id": "color", "value": { "fixedColor": "semi-dark-blue", "mode": "fixed" } } ] }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "sum by (level) (count_over_time({job=\"wildfly\"}[$__auto]))", "legendFormat": "{{level}}", "queryType": "range", "refId": "A" }
      ],
      "title": "Log Volume by Level",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Noisiest loggers in range. Names are shortened to the simple class (last segment after the final dot) so the table stays readable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text" } ] },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "logger" }, "properties": [ { "id": "custom.width", "value": 200 }, { "id": "custom.cellOptions", "value": { "type": "auto" } } ] },
          { "matcher": { "id": "byName", "options": "lines" }, "properties": [ { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } }, { "id": "custom.width", "value": 140 } ] }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [ { "displayName": "lines", "desc": true } ]
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "topk(10, sum by (logger) (count_over_time({job=\"wildfly\"} | regexp `\\[(?:[\\w$]+\\.)*(?P<logger>[\\w$]+)\\]` [$__range])))", "format": "table", "instant": true, "queryType": "instant", "refId": "A" }
      ],
      "title": "Top Loggers",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": { "logger": 0, "Value #A": 1 }, "renameByName": { "Value #A": "lines", "logger": "logger" } } }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Live WildFly log stream. Filter with the level dropdown or type in the query. Stack traces are joined to their originating line by Promtail.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
