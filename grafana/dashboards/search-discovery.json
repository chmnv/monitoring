{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "keepTime": true,
      "title": "05 DB timing",
      "type": "link",
      "url": "/d/wildfly-db"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "keepTime": true,
      "title": "10 Registration Quality",
      "type": "link",
      "url": "/d/registration-quality"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Member searches per second (all outcomes).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_searches_total{job=\"kitchensink-app\"}[5m]))",
          "legendFormat": "searches/s",
          "refId": "A"
        }
      ],
      "title": "Searches / sec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of searches that returned at least one member (excludes refine/empty).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.35 },
              { "color": "green", "value": 0.55 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "(sum(rate(kitchensink_searches_total{job=\"kitchensink-app\",outcome=\"hit\"}[5m])) / sum(rate(kitchensink_searches_total{job=\"kitchensink-app\",outcome=~\"hit|zero\"}[5m]))) and on() (sum(rate(kitchensink_searches_total{job=\"kitchensink-app\",outcome=~\"hit|zero\"}[5m])) > 0)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "title": "Hit Rate (hit vs zero)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Valid queries with no matches — user found nothing useful.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 0.05 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_searches_total{job=\"kitchensink-app\",outcome=\"zero\"}[5m]))",
          "legendFormat": "zero",
          "refId": "A"
        }
      ],
      "title": "Zero-result / sec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Short queries (len<=2) — exploratory / needs refine.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_searches_total{job=\"kitchensink-app\",outcome=\"refine\"}[5m]))",
          "legendFormat": "refine",
          "refId": "A"
        }
      ],
      "title": "Refine (short q) / sec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "p95 end-to-end search latency (API + DB). Not pool timing — that is dashboard 05.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kitchensink_search_duration_seconds_bucket{job=\"kitchensink-app\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "Search p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Average number of members returned per search.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "(sum(rate(kitchensink_search_results_sum{job=\"kitchensink-app\"}[5m])) / sum(rate(kitchensink_search_results_count{job=\"kitchensink-app\"}[5m]))) and on() (sum(rate(kitchensink_search_results_count{job=\"kitchensink-app\"}[5m])) > 0)",
          "legendFormat": "avg results",
          "refId": "A"
        }
      ],
      "title": "Avg Results / Search",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Does search return useful results? Outcomes over time.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(kitchensink_searches_total{job=\"kitchensink-app\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Search Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Search latency avg / p95 / p99.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_search_duration_seconds_sum{job=\"kitchensink-app\"}[5m])) / clamp_min(sum(rate(kitchensink_search_duration_seconds_count{job=\"kitchensink-app\"}[5m])), 1e-9)",
          "legendFormat": "avg",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kitchensink_search_duration_seconds_bucket{job=\"kitchensink-app\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(kitchensink_search_duration_seconds_bucket{job=\"kitchensink-app\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Search Duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Outcome totals since process start.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "id": 9,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum by (outcome) (kitchensink_searches_total{job=\"kitchensink-app\"})",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Outcomes (total)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "JPA search operation timing only (dashboard 05 context).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "sum(rate(kitchensink_db_operation_duration_seconds_sum{job=\"kitchensink-app\",operation=\"search\"}[5m])) / clamp_min(sum(rate(kitchensink_db_operation_duration_seconds_count{job=\"kitchensink-app\",operation=\"search\"}[5m])), 1e-9)",
          "legendFormat": "search DB avg",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kitchensink_db_operation_duration_seconds_bucket{job=\"kitchensink-app\",operation=\"search\"}[5m])) by (le))",
          "legendFormat": "search DB p95",
          "refId": "B"
        }
      ],
      "title": "DB Op: search",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Average result-set size over time.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "expr": "(sum(rate(kitchensink_search_results_sum{job=\"kitchensink-app\"}[5m])) / sum(rate(kitchensink_search_results_count{job=\"kitchensink-app\"}[5m]))) and on() (sum(rate(kitchensink_search_results_count{job=\"kitchensink-app\"}[5m])) > 0)",
          "legendFormat": "avg size",
          "refId": "A"
        }
      ],
      "title": "Result Size (avg)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["kitchensink", "search", "discovery", "business"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "11 Search & Discovery",
  "uid": "search-discovery",
  "version": 1,
  "weekStart": ""
}
