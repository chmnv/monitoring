      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "avg by (mode) (rate(windows_cpu_time_total{mode!=\"idle\"}[5m])) * 100", "legendFormat": "{{mode}}", "range": true, "refId": "A" }
      ],
