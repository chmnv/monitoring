        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "(1 - windows_memory_available_bytes / windows_memory_physical_total_bytes) * 100", "legendFormat": "RAM used", "range": true, "refId": "A" }
      ],
      "title": "RAM Used",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "System drive (C:) space used.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
