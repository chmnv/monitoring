    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "CPU time distribution by mode (averaged across cores).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text",
