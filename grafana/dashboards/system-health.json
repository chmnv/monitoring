    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rolling 1h availability per job (shows brief outages without waiting for 24h averages).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
