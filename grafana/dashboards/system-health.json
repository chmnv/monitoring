        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-red" },
            { "color": "semi-dark-yellow", "value": 99 },
            { "color": "semi-dark-green", "value": 99.9 }
          ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "100 * avg(avg_over_time(up[24h]))", "legendFormat": "SLA 24h", "range": true, "refId": "A" }
