        { "editorMode": "code", "expr": "(sum(rate(kitchensink_registration_failures_total{job=\"kitchensink-app\",reason=\"error\"}[6h])) / clamp_min(sum(rate(kitchensink_registration_attempts_total{job=\"kitchensink-app\"}[6h])), 1e-9)) / (1 - 0.999)", "legendFormat": "slow burn (6h)", "range": true, "refId": "B" }
