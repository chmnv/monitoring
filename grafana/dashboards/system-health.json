  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Average scrape availability across all Prometheus jobs over the last 24 hours (platform reachability SLA — measures whether targets respond to scrapes, not app correctness).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-red" },
            { "color": "semi-dark-yellow", "value": 99 },
            { "color": "semi-dark-green", "value": 99.9 }
          ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "100 * avg(avg_over_time(up[24h]))", "legendFormat": "SLA 24h", "range": true, "refId": "A" }
      ],
      "title": "Platform SLA (24h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Average scrape availability across all jobs over the last 7 days.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-red" },
            { "color": "semi-dark-yellow", "value": 99 },
            { "color": "semi-dark-green", "value": 99.9 }
          ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "100 * avg(avg_over_time(up[7d]))", "legendFormat": "SLA 7d", "range": true, "refId": "A" }
      ],
      "title": "Platform SLA (7d)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Remaining error budget for a 99.9% availability SLO over 7 days. 0% means the budget is exhausted (availability below 99.9%).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-red" },
            { "color": "semi-dark-yellow", "value": 25 },
            { "color": "semi-dark-green", "value": 50 }
          ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "clamp_min(100 * (avg(avg_over_time(up[7d])) - 0.999) / 0.001, 0)", "legendFormat": "budget left", "range": true, "refId": "A" }
      ],
      "title": "Error Budget Left (99.9%/7d)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "1 − Undertow listener/processing errors ÷ requests over 5m. Not HTTP 2xx success — app 4xx/5xx responses do not move this metric.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-red" },
            { "color": "semi-dark-yellow", "value": 99 },
            { "color": "semi-dark-green", "value": 99.9 }
          ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "100 * (1 - sum(rate(wildfly_undertow_error_count_total{job=\"wildfly-management\",server=\"default-server\"}[5m])) / clamp_min(sum(rate(wildfly_undertow_request_count_total{job=\"wildfly-management\",server=\"default-server\"}[5m])), 0.0001))", "legendFormat": "no listener err %", "range": true, "refId": "A" }
      ],
      "title": "Undertow OK (listener)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Lifetime registration success rate (ok / (ok + failures)). Shows N/A until the first registration attempt.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "noValue": "N/A",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-red" },
            { "color": "semi-dark-yellow", "value": 70 },
            { "color": "semi-dark-green", "value": 90 }
          ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "100 * sum(kitchensink_registrations_total{job=\"kitchensink-app\"}) / (sum(kitchensink_registrations_total{job=\"kitchensink-app\"}) + sum(kitchensink_registration_failures_total{job=\"kitchensink-app\"}))", "legendFormat": "app OK %", "range": true, "refId": "A" }
      ],
      "title": "App Success (lifetime)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Fast-burn rate of the 99.9% app SLO over 1h. 1 = budget spent exactly on schedule; >1 = burning too fast. Based on unexpected registration errors (reason=error), NOT validation/duplicate friction.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "noValue": "N/A",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-green" },
            { "color": "semi-dark-yellow", "value": 1 },
            { "color": "semi-dark-red", "value": 14.4 }
          ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 15,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "(sum(rate(kitchensink_registration_failures_total{job=\"kitchensink-app\",reason=\"error\"}[1h])) / sum(rate(kitchensink_registration_attempts_total{job=\"kitchensink-app\"}[1h]))) / (1 - 0.999)", "legendFormat": "burn 1h", "range": true, "refId": "A" }
      ],
      "title": "SLO Burn Rate (1h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current up/down state per scrape job.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "semi-dark-red", "index": 1, "text": "DOWN" }, "1": { "color": "semi-dark-green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-red" },
            { "color": "semi-dark-green", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 4 },
      "id": 7,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
