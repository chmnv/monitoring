          "decimals": 1,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-green" },
            { "color": "semi-dark-yellow", "value": 75 },
            { "color": "semi-dark-red", "value": 90 }
