        { "editorMode": "code", "expr": "100 * base_memory_usedHeap_bytes{job=\"wildfly-management\"} / base_memory_maxHeap_bytes{job=\"wildfly-management\"}", "legendFormat": "Heap used", "range": true, "refId": "A" }
