        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "from": 100,
                "result": {
                  "color": "semi-dark-green",
                  "index": 0,
                  "text": "OPERATIONAL"
                },
                "to": 100
              },
              "type": "range"
            },
            {
              "options": {
                "from": 0.01,
                "result": {
                  "color": "semi-dark-yellow",
                  "index": 1,
                  "text": "DEGRADED"
                },
                "to": 99.99
              },
              "type": "range"
            },
            {
              "options": {
                "from": 0,
                "result": {
                  "color": "semi-dark-red",
                  "index": 2,
                  "text": "OUTAGE"
                },
                "to": 0
              },
              "type": "range"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-red"
              },
