  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "HTTP request throughput (all listeners). The 'traffic' golden signal.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text" } ] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "none", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(wildfly_undertow_request_count_total{job=\"wildfly-management\",server=\"default-server\"}[5m]))", "legendFormat": "req/s", "range": true, "refId": "A" }
      ],
      "title": "Requests / sec",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Undertow listener/processing errors ÷ requests (wildfly_undertow_error_count). NOT HTTP 4xx/5xx response rate — app 404s do not increment this counter.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-green" },
            { "color": "semi-dark-yellow", "value": 1 },
            { "color": "semi-dark-red", "value": 5 }
          ]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "100 * sum(rate(wildfly_undertow_error_count_total{job=\"wildfly-management\",server=\"default-server\"}[5m])) / clamp_min(sum(rate(wildfly_undertow_request_count_total{job=\"wildfly-management\",server=\"default-server\"}[5m])), 0.0001)", "legendFormat": "listener err %", "range": true, "refId": "A" }
      ],
      "title": "Listener Error Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Average request time per servlet (total_request_time / request_count at deployment scope). The listener-level processing_time counter stays 0 in WildFly, so latency is derived from the servlet-scoped metric. The 'latency' golden signal.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "semi-dark-green" },
            { "color": "semi-dark-yellow", "value": 0.25 },
            { "color": "semi-dark-red", "value": 1 }
          ]},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.1",
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(wildfly_undertow_total_request_time_total_seconds{job=\"wildfly-management\",deployment=\"kitchensink.war\"}[5m])) / clamp_min(sum(rate(wildfly_undertow_request_count_total{job=\"wildfly-management\",deployment=\"kitchensink.war\"}[5m])), 0.0001)", "legendFormat": "avg", "range": true, "refId": "A" }
      ],
      "title": "Avg Request Time",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Currently active Undertow HTTP sessions (transport-level sessions, NOT authenticated app logins — those are on dashboard 12).",
