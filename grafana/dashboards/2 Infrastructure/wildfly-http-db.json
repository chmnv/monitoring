        { "editorMode": "code", "expr": "sum(wildfly_undertow_active_sessions{job=\"wildfly-management\"})", "legendFormat": "sessions", "range": true, "refId": "A" }
      ],
      "title": "HTTP Sessions (Undertow)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
