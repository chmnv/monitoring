      "pluginVersion": "11.6.1",
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "topk(10, sum by (operation) (count_over_time({job=\"wildfly-audit\", operation=~\".+\"}[$__range])))", "format": "table", "instant": true, "queryType": "instant", "refId": "A" }
