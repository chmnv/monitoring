# =========================================================================
# SMTP / email-alert configuration TEMPLATE (safe to commit — no real secrets).
#
# Setup:
#   1. Copy this file to `.env`  (which is git-ignored):
#        cp smtp.example.env .env      # or copy it in your editor
#   2. Fill in the four values below with your real Gmail + App Password.
#   3. Recreate Grafana:   docker compose up -d grafana
#
# How to get a Gmail APP PASSWORD (required — a normal password will NOT work):
#   1. Enable 2-Step Verification on your Google account
#      (https://myaccount.google.com/security).
#   2. Open https://myaccount.google.com/apppasswords
#   3. Create an app password (any name, e.g. "grafana"); Google shows a
#      16-character code like "abcd efgh ijkl mnop".
#   4. Paste it into SMTP_PASSWORD below WITHOUT spaces (abcdefghijklmnop).
# =========================================================================

# Gmail account used to SEND alert emails (the SMTP login).
SMTP_USER=your.address@gmail.com

# Gmail App Password (16 chars, no spaces).
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# "From" address shown on alert emails (usually the same Gmail address).
SMTP_FROM=your.address@gmail.com

# Where alert emails are delivered (can be the same address).
ALERT_EMAIL_TO=your.address@gmail.com

# --- Telegram alerts (optional but preferred for mentor demo) ---
# 1. Create a bot with @BotFather → BOT token
# 2. Open the bot chat → /start
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Jira tickets from alerts (Grafana native Jira contact point) ---
# 1. Create a Kanban project → note its KEY (e.g. KAN)
# 2. API token: https://id.atlassian.com/manage-profile/security/api-tokens
# 3. Email must be the Atlassian account email used to create the token
# Issue type name must match Jira (EN: Task / Bug; RU UI often "Задание").
# Grafana calls jira-bridge (webhook) — native Jira contact point hits HTTP 410
# on current Jira Cloud (/rest/api/3/search removed).
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_URL=https://your-domain.atlassian.net/rest/api/3
JIRA_EMAIL=your.address@gmail.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
# Prefer ID (locale-proof). Task/Задание in a typical team Kanban is often 10004.
JIRA_ISSUE_TYPE_ID=10004
